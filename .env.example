# ── Core ──
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require
# Supabase session pooler (port 5432) for Prisma migrations and seeding.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_TEST=postgresql://app:app@localhost:5432/acquisition_test
# 32-byte key, base64. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Session cookie secure flag (set true behind HTTPS)
COOKIE_SECURE=false
APP_TIMEZONE=Africa/Johannesburg

# ── Safety gates (all off by default) ──
# Simulation mode: fake providers only, seeded dummy leads.
SIMULATION_MODE=true
# Hard kill switch for any AUTOMATED provider. Manual (iPhone) workflows are unaffected.
ALLOW_AUTOMATED_OUTREACH=false
# Email sequences (docs/OUTREACH.md). Live sending ALSO needs Launch Command = Start on /outreach,
# the email_sequences provider enabled with an authorisation reference, and SIMULATION_MODE=false.
OUTREACH_LIVE_SEND=false
# Worker schedules the Maputo batches and the reply/stop watch (dry run unless all of the above).
OUTREACH_SCHEDULER=false

# ── Self-hosted AI ──
# mock | ollama
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# mock | http
STT_PROVIDER=mock
STT_URL=http://localhost:8001
TTS_PROVIDER=mock
TTS_URL=http://localhost:8002

# ── Future SIP (disabled until carrier authorisation exists) ──
# Browser softphone for live call assist (business SIP/VoIP with WebRTC). Leave empty to disable.
SIP_WSS_URL=
SIP_URI=
SIP_PASSWORD=
SIP_DISPLAY_NAME=
ASTERISK_ARI_URL=
ASTERISK_ARI_USER=
ASTERISK_ARI_PASSWORD=

# ── Seed ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
DATABASE_URL_E2E=postgresql://app:app@localhost:5432/acquisition_e2e

# ── Jobs ──
# inline: run jobs inside the request (dev). queue: pg-boss + `npm run worker` (production/compose).
JOBS_MODE=inline

# ── Simulation only ──
# Pin the clock (ISO time) to exercise CPA contact-hour rules. Ignored unless SIMULATION_MODE=true
# and ALLOW_AUTOMATED_OUTREACH=false.
# SIMULATION_CLOCK=2026-10-21T08:00:00Z
