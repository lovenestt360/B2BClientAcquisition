{
  "name": "b2b-client-acquisition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "laptop": "tsx scripts/laptop.ts",
    "laptop:dev": "tsx scripts/laptop.ts --dev",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "postinstall": "prisma generate",
    "outreach:rehearsal": "tsx scripts/outreach-rehearsal.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "imapflow": "^1.7.8",
    "jssip": "^3.10.1",
    "libphonenumber-js": "^1.13.15",
    "mailparser": "^3.11.0",
    "next": "^15.5.28",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.7.0",
    "pg-boss": "^10.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "dotenv": "^18.0.8",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "smtp-server": "^3.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
